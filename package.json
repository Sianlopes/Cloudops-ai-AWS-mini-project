{
  "name": "cloudops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --configLoader native",
    "start": "node --env-file-if-exists=.env server/index.js",
    "worker": "node --env-file-if-exists=.env server/worker.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin:reset": "node --env-file-if-exists=.env scripts/reset-password.mjs",
    "demo-shop": "node examples/acme-shop/server.js",
    "sync:shop-client": "node scripts/sync-shop-client.mjs",
    "package:lambda": "node scripts/package-lambda.mjs",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-sns": "^3.1148.0",
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@aws-sdk/client-ssm": "^3.1148.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.0.0"
  }
}
