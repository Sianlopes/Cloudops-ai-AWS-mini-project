# Local development requires Node.js 24. npm run dev starts an embedded worker.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
SQLITE_PATH=data/cloudops.sqlite
APP_ORIGIN=http://127.0.0.1:5173
# Optional for local development; mandatory in production.
# DATABASE_URL=postgresql://cloudops:YOUR_PASSWORD@localhost:5432/cloudops
# DB_SSL=true
# DB_CA_FILE=/app/certs/global-bundle.pem
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=CHOOSE_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
# Production: NODE_ENV=production, HOST=0.0.0.0, APP_ORIGIN=https://your-domain
# TRUST_PROXY=1 only when exactly one trusted ALB sits in front of the API.
# EMBEDDED_WORKER=false
# AWS_REGION=ap-south-1
# SSM_PARAMETER_PATH=/cloudops/prod/
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT/cloudops-incidents.fifo
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:ACCOUNT:cloudops-alerts
# S3_LOG_BUCKET=YOUR_PRIVATE_LOG_BUCKET
# Never add AWS access keys. EC2/Lambda use IAM roles.
